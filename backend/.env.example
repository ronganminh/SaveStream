SAVESTREAM_ENVIRONMENT=local
SAVESTREAM_LOG_FORMAT=json
SAVESTREAM_LOG_LEVEL=INFO
SAVESTREAM_HTTP_TIMEOUT_SECONDS=15
SAVESTREAM_HTTP_STREAM_TIMEOUT_SECONDS=30
SAVESTREAM_PROXY_CHECK_TIMEOUT_SECONDS=10
SAVESTREAM_UPDATE_TIMEOUT_SECONDS=15

# Phase 2 API/infrastructure
SAVESTREAM_DATABASE_URL=postgresql+asyncpg://savestream:savestream@localhost:5432/savestream
SAVESTREAM_REDIS_URL=redis://localhost:6379/0
SAVESTREAM_CELERY_BROKER_URL=redis://localhost:6379/1
SAVESTREAM_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SAVESTREAM_MINIO_ENDPOINT=http://localhost:9000
SAVESTREAM_MINIO_ACCESS_KEY=savestream
SAVESTREAM_MINIO_SECRET_KEY=savestream-local-only
SAVESTREAM_MINIO_BUCKET=savestream-recordings
SAVESTREAM_MINIO_SECURE=false
SAVESTREAM_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SAVESTREAM_REQUEST_ID_HEADER=X-Request-ID
SAVESTREAM_DEPENDENCY_TIMEOUT_SECONDS=2
SAVESTREAM_OUTBOX_POLL_SECONDS=1

# Optional legacy recorder secret paths
# SAVESTREAM_COOKIES_FILE=/absolute/path/to/cookies.json
# SAVESTREAM_TELEGRAM_CONFIG_FILE=/absolute/path/to/telegram.json

# Phase 3 Identity
SAVESTREAM_JWT_SECRET=savestream-dev-only-change-me
SAVESTREAM_JWT_ISSUER=savestream
SAVESTREAM_JWT_AUDIENCE=savestream-clients
SAVESTREAM_ACCESS_TOKEN_TTL_SECONDS=900
SAVESTREAM_REFRESH_TOKEN_TTL_SECONDS=2592000
SAVESTREAM_ONE_TIME_TOKEN_TTL_SECONDS=1800
SAVESTREAM_REFRESH_COOKIE_NAME=savestream_refresh
SAVESTREAM_FRONTEND_BASE_URL=http://localhost:5173
SAVESTREAM_SMTP_HOST=localhost
SAVESTREAM_SMTP_PORT=1025
SAVESTREAM_EMAIL_FROM=SaveStream <no-reply@savestream.local>
SAVESTREAM_LOGIN_RATE_LIMIT=5
SAVESTREAM_LOGIN_RATE_WINDOW_SECONDS=60
SAVESTREAM_AUTH_WRITE_RATE_LIMIT=5
SAVESTREAM_AUTH_WRITE_RATE_WINDOW_SECONDS=3600

# Phase 4 Recording
SAVESTREAM_RECORDING_TEMP_DIR=/tmp/savestream-recordings
SAVESTREAM_RECORDING_MAX_DURATION_SECONDS=14400
SAVESTREAM_RECORDING_HEARTBEAT_SECONDS=10
SAVESTREAM_RECORDING_STALE_AFTER_SECONDS=60
SAVESTREAM_RECORDING_MAX_ATTEMPTS=3
SAVESTREAM_ARTIFACT_PRESIGN_SECONDS=900
SAVESTREAM_SSE_POLL_SECONDS=1
SAVESTREAM_IDEMPOTENCY_TTL_SECONDS=86400
