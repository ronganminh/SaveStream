SAVESTREAM_ENVIRONMENT=local
SAVESTREAM_LOG_FORMAT=json
SAVESTREAM_LOG_LEVEL=INFO
SAVESTREAM_HTTP_TIMEOUT_SECONDS=15
SAVESTREAM_HTTP_STREAM_TIMEOUT_SECONDS=30
SAVESTREAM_PROXY_CHECK_TIMEOUT_SECONDS=10
SAVESTREAM_UPDATE_TIMEOUT_SECONDS=15

# Phase 2 API/infrastructure
SAVESTREAM_DATABASE_URL=postgresql+asyncpg://savestream:savestream@localhost:5432/savestream
SAVESTREAM_REDIS_URL=redis://localhost:6379/0
SAVESTREAM_CELERY_BROKER_URL=redis://localhost:6379/1
SAVESTREAM_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SAVESTREAM_MINIO_ENDPOINT=http://localhost:9000
SAVESTREAM_MINIO_ACCESS_KEY=savestream
SAVESTREAM_MINIO_SECRET_KEY=savestream-local-only
SAVESTREAM_MINIO_BUCKET=savestream-recordings
SAVESTREAM_MINIO_SECURE=false
SAVESTREAM_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SAVESTREAM_REQUEST_ID_HEADER=X-Request-ID
SAVESTREAM_DEPENDENCY_TIMEOUT_SECONDS=2
SAVESTREAM_OUTBOX_POLL_SECONDS=1

# Optional legacy recorder secret paths
# SAVESTREAM_COOKIES_FILE=/absolute/path/to/cookies.json
# SAVESTREAM_TELEGRAM_CONFIG_FILE=/absolute/path/to/telegram.json

# Phase 3 Identity
SAVESTREAM_JWT_SECRET=savestream-dev-only-change-me
SAVESTREAM_JWT_ISSUER=savestream
SAVESTREAM_JWT_AUDIENCE=savestream-clients
SAVESTREAM_ACCESS_TOKEN_TTL_SECONDS=900
SAVESTREAM_REFRESH_TOKEN_TTL_SECONDS=2592000
SAVESTREAM_ONE_TIME_TOKEN_TTL_SECONDS=1800
SAVESTREAM_REFRESH_COOKIE_NAME=savestream_refresh
SAVESTREAM_FRONTEND_BASE_URL=http://localhost:5173
SAVESTREAM_SMTP_HOST=localhost
SAVESTREAM_SMTP_PORT=1025
SAVESTREAM_SMTP_USERNAME=
SAVESTREAM_SMTP_PASSWORD=
SAVESTREAM_SMTP_STARTTLS=false
SAVESTREAM_EMAIL_FROM=SaveStream <no-reply@savestream.local>
SAVESTREAM_LOGIN_RATE_LIMIT=5
SAVESTREAM_LOGIN_RATE_WINDOW_SECONDS=60
SAVESTREAM_AUTH_WRITE_RATE_LIMIT=5
SAVESTREAM_AUTH_WRITE_RATE_WINDOW_SECONDS=3600

# Phase 4 Recording
SAVESTREAM_RECORDING_TEMP_DIR=/tmp/savestream-recordings
SAVESTREAM_RECORDING_MAX_DURATION_SECONDS=14400
SAVESTREAM_RECORDING_HEARTBEAT_SECONDS=10
SAVESTREAM_RECORDING_STALE_AFTER_SECONDS=60
SAVESTREAM_RECORDING_MAX_ATTEMPTS=3
SAVESTREAM_ARTIFACT_PRESIGN_SECONDS=900
SAVESTREAM_SSE_POLL_SECONDS=1
SAVESTREAM_IDEMPOTENCY_TTL_SECONDS=86400

# Phase 5 Watch scheduler
SAVESTREAM_WATCH_SCHEDULER_TICK_SECONDS=15
SAVESTREAM_WATCH_SCHEDULER_BATCH_SIZE=50
SAVESTREAM_WATCH_SCHEDULER_LEASE_SECONDS=90
SAVESTREAM_WATCH_OFFLINE_CHECK_SECONDS=60
SAVESTREAM_WATCH_LIVE_CHECK_SECONDS=20
SAVESTREAM_WATCH_ERROR_BACKOFF_BASE_SECONDS=30
SAVESTREAM_WATCH_ERROR_BACKOFF_MAX_SECONDS=900
SAVESTREAM_WATCH_ERROR_PAUSE_THRESHOLD=5
SAVESTREAM_WATCH_JITTER_RATIO=0.2
SAVESTREAM_WATCH_MAX_CONCURRENT_RECORDINGS_PER_USER=2

# Phase 7 Payment
SAVESTREAM_PAYMENT_PROVIDER=fake
SAVESTREAM_PAYMENT_PROVIDER_BASE_URL=
SAVESTREAM_PAYMENT_PROVIDER_API_KEY=
SAVESTREAM_PAYMENT_WEBHOOK_SECRET=savestream-fake-payment-secret
SAVESTREAM_LEMON_SQUEEZY_STORE_ID=
SAVESTREAM_LEMON_SQUEEZY_VARIANT_ID=
SAVESTREAM_PAYMENT_TIMEOUT_SECONDS=15
SAVESTREAM_PAYMENT_RECONCILE_SECONDS=300

# Phase 8 Operations
SAVESTREAM_METRICS_TOKEN=savestream-local-metrics
SAVESTREAM_OPS_ALERT_EMAIL=
SAVESTREAM_OPS_ALERT_CHECK_SECONDS=60
SAVESTREAM_OPS_ALERT_COOLDOWN_SECONDS=1800
SAVESTREAM_OPS_FAILED_RECORDING_WINDOW_SECONDS=900
SAVESTREAM_OPS_OUTBOX_ALERT_THRESHOLD=100
SAVESTREAM_OPS_FAILED_RECORDING_ALERT_THRESHOLD=10
SAVESTREAM_OPS_PAYMENT_EVENT_ALERT_THRESHOLD=10
SAVESTREAM_OPS_PAUSED_WATCH_ALERT_THRESHOLD=20

# Phase 9 Production hardening
# Sensitive settings also support SAVESTREAM_<NAME>_FILE=/run/secrets/<file>.
SAVESTREAM_JWT_PREVIOUS_SECRETS=
SAVESTREAM_API_RATE_LIMIT=300
SAVESTREAM_API_RATE_WINDOW_SECONDS=60
SAVESTREAM_TRUSTED_PROXY_CIDRS=
SAVESTREAM_FORCE_HTTPS=false
SAVESTREAM_SECURITY_HEADERS_ENABLED=true
SAVESTREAM_QUOTA_MAX_WATCHES_PER_USER=100
SAVESTREAM_QUOTA_MAX_RECORDINGS_PER_DAY=100
SAVESTREAM_QUOTA_MAX_ACTIVE_RECORDINGS_PER_USER=2
SAVESTREAM_RECORDING_RETENTION_DAYS=0
SAVESTREAM_ACCOUNT_DELETION_GRACE_DAYS=0
SAVESTREAM_RETENTION_CHECK_SECONDS=3600

# Phase 10 E2E release validation
# Keep tiktok in production. fake_http is for controlled non-production E2E only.
SAVESTREAM_RECORDING_SOURCE_BACKEND=tiktok
SAVESTREAM_E2E_STREAM_BASE_URL=


# V2 B5 in-app purchases (disabled by default)
SAVESTREAM_STORE_PURCHASE_PROVIDER=disabled
SAVESTREAM_STORE_PURCHASE_TIMEOUT_SECONDS=15
SAVESTREAM_APP_STORE_BUNDLE_ID=
SAVESTREAM_APP_STORE_ISSUER_ID=
SAVESTREAM_APP_STORE_KEY_ID=
SAVESTREAM_APP_STORE_PRIVATE_KEY=
# JSON array of base64 DER Apple root certificates; supports the standard _FILE form.
SAVESTREAM_APP_STORE_ROOT_CERTIFICATES_JSON=
SAVESTREAM_APP_STORE_APP_APPLE_ID=0
SAVESTREAM_APP_STORE_ENVIRONMENT=sandbox
SAVESTREAM_GOOGLE_PLAY_PACKAGE_NAME=
SAVESTREAM_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
SAVESTREAM_GOOGLE_PLAY_RTDN_AUDIENCE=
SAVESTREAM_GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
