# Non-secret production deployment values.
# Copy to deploy/vps/production.env and keep real secrets in SAVESTREAM_SECRETS_DIR.

SAVESTREAM_SECRETS_DIR=/opt/savestream/secrets/production
SAVESTREAM_API_BIND_PORT=18001

# Canonical public origins
SAVESTREAM_PUBLIC_API_ORIGIN=https://api.savestream.online
SAVESTREAM_FRONTEND_ORIGIN=https://savestream.online
SAVESTREAM_CORS_ALLOW_ORIGINS=https://savestream.online,https://www.savestream.online

# S3-compatible recording storage (Cloudflare R2 recommended by current deployment)
SAVESTREAM_R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
SAVESTREAM_R2_BUCKET=savestream-recordings

# Keep disabled until PayPal LIVE credentials are installed and smoke-tested.
# Supported web providers: paypal, lemonsqueezy, disabled.
SAVESTREAM_PAYMENT_PROVIDER=disabled
SAVESTREAM_PAYMENT_PROVIDER_BASE_URL=https://api-m.paypal.com
SAVESTREAM_PAYPAL_CLIENT_ID=

# Legacy Lemon Squeezy identifiers remain supported if that provider is selected.
SAVESTREAM_LEMON_SQUEEZY_STORE_ID=
SAVESTREAM_LEMON_SQUEEZY_VARIANT_ID=

# System-wide cap on simultaneous cloud recordings (recorder worker concurrency).
SAVESTREAM_RECORDING_CONCURRENCY=6

# Firebase Cloud Messaging push delivery.
SAVESTREAM_PUSH_PROVIDER=fcm

# Android store purchases. Grant the service account access to the app in
# Google Play Console before changing production from disabled to google_play.
SAVESTREAM_STORE_PURCHASE_PROVIDER=google_play
SAVESTREAM_GOOGLE_PLAY_PACKAGE_NAME=com.savestream.app
SAVESTREAM_GOOGLE_PLAY_RTDN_AUDIENCE=https://api.savestream.online/v1/webhooks/google-play
SAVESTREAM_GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@savestream-d6684.iam.gserviceaccount.com
# Pack the apps highlight as "Most popular" (package codes, comma-separated).
SAVESTREAM_FEATURED_PACKAGE_CODES=standard

# iOS App Store Server API (requires opt-in apple-store compose overlay).
# These are NON-secret identifiers. Keep SubscriptionKey_*.p8 in secrets dir only.
# Do not enable the overlay until 3 consumable products + Paid Apps Agreement are ready.
SAVESTREAM_APP_STORE_ISSUER_ID=
SAVESTREAM_APP_STORE_KEY_ID=
SAVESTREAM_APP_STORE_APP_APPLE_ID=
# TestFlight: sandbox; public App Store: production.
SAVESTREAM_APP_STORE_ENVIRONMENT=sandbox

# Rewarded ads (Android app) add cloud minutes after verified AdMob SSV.
SAVESTREAM_REWARD_PROVIDER=admob
# Accepted rewarded ad units; set to empty to turn rewarded ads off.
SAVESTREAM_ADMOB_REWARD_AD_UNITS=ca-app-pub-2078852906622512/5155016450

# Operations
SAVESTREAM_OPS_ALERT_EMAIL=ops@savestream.online
SAVESTREAM_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# PostHog product analytics (server funnel events). Defaults to the SaveStream
# project token in docker-compose.production.yml (public, write-only); set it
# empty here to turn server analytics off.
# SAVESTREAM_POSTHOG_API_KEY=
