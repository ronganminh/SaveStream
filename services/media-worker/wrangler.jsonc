{
  // Media delivery Worker (media.savestream.online). See README.md.
  // The Deploy Media workflow fills in the bucket name from the VPS
  // (SAVESTREAM_R2_BUCKET) and sets the MEDIA_SIGNING_SECRET secret.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "savestream-media",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "routes": [{ "pattern": "media.savestream.online", "custom_domain": true }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "__R2_BUCKET__" }],
  "vars": { "ALLOWED_ORIGINS": "https://savestream.online,https://www.savestream.online" },
  "observability": { "enabled": true }
}
