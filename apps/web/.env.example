# Demo keeps the fixture-backed repositories.
VITE_APP_MODE=demo

# Required when VITE_APP_MODE=production.
# Local backend: http://localhost:8000
# Staging backend: https://staging-api.savestream.online
# Production backend: https://api.savestream.online
VITE_API_BASE_URL=http://localhost:8000

# Phase 7 hosted billing checkout.
# Keep false for production until Lemon Squeezy Live Mode is approved/configured.
# Set true only for staging builds backed by Lemon Squeezy Test Mode.
VITE_BILLING_CHECKOUT_ENABLED=false
