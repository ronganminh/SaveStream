# Production web build.
VITE_APP_MODE=production
VITE_API_BASE_URL=https://api.savestream.online

# Keep disabled until PayPal LIVE credentials are installed and the release payment smoke passes.
VITE_BILLING_CHECKOUT_ENABLED=false

# Public PayPal REST app client ID. Never put the client secret in the web build.
VITE_PAYPAL_CLIENT_ID=
